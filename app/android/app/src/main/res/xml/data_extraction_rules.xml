<?xml version="1.0" encoding="utf-8"?>
<!-- S11: exclude all app data (profiles, certificate pins, settings) from cloud backup
     and device-to-device transfer. Passwords live only in the Android Keystore-backed vault. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
